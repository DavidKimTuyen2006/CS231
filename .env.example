# Sao chép file này thành `.env` và sửa đường dẫn theo máy của bạn.
# `.env` không được đưa lên Git. Đường dẫn tương đối tính từ thư mục gốc repo.

# Nơi lưu dataset Arrow (tạo bởi scripts/download_dataset.py)
# Hoặc trỏ tới cache Hugging Face đã tải, ví dụ D:/huggingface/datasets/mcimpoi___minc-2500_split_1
# Dùng dấu / cho đường dẫn Windows, nhất là khi đặt giá trị trong dấu nháy kép.
DATASET_ROOT=./data/minc-2500

# Nơi lưu feature cache (HSV, HOG-64, HOG-128) — có thể đặt ổ đĩa lớn hơn
CACHE_ROOT=./cache

# Nơi lưu model, log, dự đoán chi tiết của từng run
OUTPUT_ROOT=./outputs

# Token Hugging Face — KHÔNG cần với dataset công khai này.
# Chỉ đặt nếu bạn gặp giới hạn rate-limit khi tải.
# HF_TOKEN=
